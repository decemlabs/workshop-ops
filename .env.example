# Переменные для docker compose (файл .env рядом с compose.yaml).

POSTGRES_DB=workshop_ops
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

POSTGRES_PORT=5432

# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Хосты, на которые отвечает Django, через запятую.
ALLOWED_HOSTS=localhost,127.0.0.1

# Порт, на котором наружу торчит Caddy с фронтом.
WEB_PORT=8080

# True, когда перед связкой стоит внешний HTTPS-прокси: редирект на https и Secure-куки.
HTTPS_ONLY=False

# Домены фронта, если он уехал на свой адрес. При одном домене на фронт и бэк - пусто.
CSRF_TRUSTED_ORIGINS=
