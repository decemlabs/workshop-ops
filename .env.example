# Переменные для docker compose (файл .env рядом с compose.yaml).
# Все значения имеют разумные значения по умолчанию — файл нужен только для их замены.

POSTGRES_DB=workshop_ops
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Порт на хосте. 5433 по умолчанию: 5432 занят контейнером другого проекта.
POSTGRES_PORT=5433
